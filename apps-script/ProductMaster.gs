function getProductMasterStatus_() {
  return { status: PRODUCT_MASTER_STATE_.status, warning: PRODUCT_MASTER_STATE_.warning || "", asOf: PRODUCT_MASTER_STATE_.asOf || "", count: Number(PRODUCT_MASTER_STATE_.count || 0) };
}

function loadProductMaster_(forceLive) {
  if (!forceLive && PRODUCT_MASTER_REQUEST_ROWS_) return PRODUCT_MASTER_REQUEST_ROWS_;
  var cache = null;
  try { if (typeof CacheService !== "undefined") cache = CacheService.getScriptCache(); } catch (error) {}
  if (!forceLive && cache) {
    try {
      var cached = readProductMasterCache_(cache);
      if (cached) {
        PRODUCT_MASTER_REQUEST_ROWS_ = cached.rows;
        PRODUCT_MASTER_STATE_ = { status: "cached", warning: cached.warning || "", asOf: cached.asOf || "", count: cached.rows.length };
        return cached.rows;
      }
    } catch (error) {}
  }
  try {
    var spreadsheet = SpreadsheetApp.openById(PRODUCT_MASTER_SPREADSHEET_ID_);
    var sheets = spreadsheet.getSheets();
    var target = null;
    for (var i = 0; i < sheets.length; i += 1) if (Number(sheets[i].getSheetId()) === PRODUCT_MASTER_SHEET_ID_) { target = sheets[i]; break; }
    if (!target) throw new Error("製品マスタの対象シートが見つかりません。");
    var lastRow = Number(target.getLastRow() || 0);
    if (lastRow < 4) throw new Error("製品マスタにデータ行がありません。");
