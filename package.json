{
  "name": "production-progress-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Google Sheets と同期する生産工程管理 Web アプリ",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "build": "node tools/build-apps-script.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:contrast": "node tools/contrast-audit.mjs",
    "qa:install": "playwright install chromium",
    "qa": "node tools/browser-smoke.mjs",
    "qa:conflicts": "node tools/conflict-recovery-qa.mjs",
    "qa:stock-dialog": "node tools/finished-stock-dialog-qa.mjs",
    "qa:stock-completion": "node tools/stock-completion-qa.mjs",
    "qa:legacy": "node",
    "check": "npm run build && npm test && npm run test:contrast"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
